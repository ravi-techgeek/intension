{
  "manifest_version": 3,
  "name": "Intention",
  "version": "1.0.0",
  "description": "Opening YouTube asks what you came for first. Type a search, and YouTube opens straight to the results.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["*://*.youtube.com/*"],
  "declarative_net_request": {
    "rule_resources": [{ "id": "home_redirect", "enabled": true, "path": "rules.json" }]
  },
  "content_scripts": [{
    "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://youtube.com/*"],
    "js": ["guard.js"],
    "run_at": "document_start"
  }],
  "web_accessible_resources": [{
    "resources": ["intention.html"],
    "matches": ["*://*.youtube.com/*"]
  }],
  "action": { "default_title": "Intention: search YouTube on purpose" },
  "background": { "service_worker": "background.js" }
}
